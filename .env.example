# AWS
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET_NAME=mlops-paas-artifacts
AWS_QUERYSTRING_AUTH=True
S3_TRAINING_DATA_PREFIX=training-data/

# Training backend: aws_batch, sagemaker, or local
TRAINING_BACKEND=aws_batch

# SageMaker Training
AWS_SAGEMAKER_ROLE_ARN=arn:aws:iam::<account-id>:role/mlops-sagemaker-execution-role
SAGEMAKER_INSTANCE_TYPE=ml.m5.large
SAGEMAKER_MAX_RUN=3600
SAGEMAKER_MAX_WAIT=7200
SAGEMAKER_OUTPUT_PREFIX=tenants
SAGEMAKER_SKLEARN_FRAMEWORK_VERSION=1.2-1
SAGEMAKER_PY_VERSION=py3
SAGEMAKER_USE_SPOT=True
LOCAL_TRAINING_TIMEOUT=1800
LOCAL_TRAINING_MAX_OUTPUT_MB=500
LOCAL_TRAINING_ALLOW_PIP_INSTALL=True

# AWS Batch Training
AWS_BATCH_REGION=ap-southeast-1
AWS_BATCH_JOB_QUEUE=mlops-paas-training-queue
AWS_BATCH_JOB_DEFINITION=mlops-paas-training-job
AWS_BATCH_LOG_GROUP=/aws/batch/mlops-training
ENABLE_GPU_TRAINING=False
AWS_BATCH_GPU_JOB_QUEUE=
AWS_BATCH_GPU_JOB_DEFINITION=
TRAINING_MAX_RUNTIME_SECONDS=43200
TRAINING_MONTHLY_QUOTA_SECONDS=43200
TRAINING_MAX_ACTIVE_JOBS_PER_TENANT=1

# GitHub
GITHUB_TOKEN=your_github_token
GITHUB_REPO=your_github_user/your_repo_name

# DockerHub
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token

# OAuth
GOOGLE_OAUTH2_CLIENT_ID=your_google_oauth_client_id
GITHUB_OAUTH2_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH2_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/github/callback

# Email SMTP
EMAIL_HOST_USER=your_email
EMAIL_HOST_PASSWORD=your_email_app_password

# Django Control Plane
DJANGO_SECRET_KEY=your_django_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,control-plane,mlops_paas_django
CONTROL_PLANE_INTERNAL_URL=http://control-plane:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# FastAPI Model Server & Packager
MODEL_SERVER_PUBLIC_URL=http://localhost:5000
MODEL_PACKAGER_URL=http://model-packager:7000

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_NAME=NIDS-XGBoost
MLFLOW_DB_SCHEMA=mlflow
MODEL_ID=NIDS-model
MODEL_URI=models:/nids-model/Production

# Messaging
REDPANDA_BROKERS=localhost:19092
KAFKA_TOPIC=mlops_paas_production_logs

# Postgres Database
# NOTE: If your password contains special characters (e.g. @, %, #, +), the
#       system will URL-encode it automatically when building connection URLs.
#       Set DB_PASSWORD to the raw value — do NOT pre-encode it here.
#       Example: DB_PASSWORD=Hoang0123@  (raw, not Hoang0123%40)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_HOST_RW=localhost
DB_HOST_RO=localhost
DB_PORT=5432
DB_NAME=mlops_paas_db
DB_SCHEMA=control_plane
POSTGRES_VOLUME_NAME=mlops_paas_pgdata

# pgADmin 4 
PGADMIN_EMAIL=your_pgadmin_email
PGADMIN_PASSWORD=your_pgadmin_password

# Monitoring
DRIFT_THRESHOLD=0.6
EVIDENTLY_TRIGGER_THRESHOLD=100
MIN_SAMPLES=100
MAX_SAMPLES=100000
REFERENCE_DATA_S3_URI=s3://mlops-paas-artifacts/reference-data/demo-model/reference.csv
DRIFT_REPORTS_S3_PREFIX=drift-reports

# Webhook
WEBHOOK_URL=http://control_plane:8000/api/v1/internal/drift-webhook
WEBHOOK_SECRET=super-secret-key
MODEL_BUILD_WEBHOOK_SECRET=change-me-local-build-webhook-secret

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/auth
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/oauth/github/callback

# Python
PYTHONUTF8=1
