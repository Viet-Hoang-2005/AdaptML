# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_DEFAULT_REGION=ap-southeast-1

# AWS Batch Training
TRAINING_BACKEND=aws_batch
AWS_BATCH_REGION=ap-southeast-1
ENABLE_GPU_TRAINING=False
AWS_BATCH_GPU_JOB_QUEUE=
AWS_BATCH_GPU_JOB_DEFINITION=
AWS_BATCH_JOB_QUEUE=mlops-paas-training-queue
AWS_BATCH_JOB_DEFINITION=mlops-paas-training-job

# GitHub
GITHUB_REPO=Viet-Hoang-2005/MLOps-nids-system
GITHUB_TOKEN=

# DockerHub
DOCKERHUB_USERNAME=tnvhoang
DOCKERHUB_TOKEN=

# OAuth Credentials
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# GitHub OAuth
GITHUB_OAUTH2_CLIENT_ID=
GITHUB_OAUTH2_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://mlops-nids-nt114.id.vn/oauth/github/callback

# Email SMTP
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Django Control Plane
DJANGO_SECRET_KEY=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,control-plane,api.mlops-nids-nt114.id.vn
CORS_ALLOWED_ORIGINS=https://mlops-nids-nt114.id.vn,http://localhost:5173,http://127.0.0.1:5173

# FastAPI Model Server & Packager
MODEL_SERVER_PUBLIC_URL=http://localhost:5000
MODEL_PACKAGER_URL=http://model-packager:7000
CONTROL_PLANE_INTERNAL_URL=http://control-plane:8000
DOCKER_NETWORK_NAME=mlops_paas_network

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_NAME=NIDS-XGBoost
MLFLOW_DB_SCHEMA=mlflow
MODEL_ID=NIDS-model
MODEL_URI=models:/nids-model/Production
MLFLOW_EXPERIMENT_NAME=mlops-paas-training
MLFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,mlflow,mlflow:5000,mlops_paas_mlflow,mlops_paas_mlflow:5000
MLFLOW_TRACKING_REQUIRED=false
MLFLOW_HTTP_REQUEST_TIMEOUT=10

# Messaging
REDPANDA_BROKERS=localhost:19092
KAFKA_TOPIC=mlops_paas_production_data

# PostgreSQL Database
DB_USER=
DB_PASSWORD=
DB_HOST_RW=postgres
DB_HOST_RO=postgres
DB_PORT=5432
DB_NAME=mlops_paas_db
DB_SCHEMA=control_plane

# pgADmin 4 
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Monitoring
DRIFT_THRESHOLD=0.6
EVIDENTLY_TRIGGER_THRESHOLD=100
MIN_SAMPLES=100
MAX_SAMPLES=100000
DRIFT_REPORTS_S3_PREFIX=drift-reports

# Webhook
CONTROL_PLANE_WEBHOOK_URL=http://mlops-paas-control-plane:8000/api/drift/internal/trigger-drift-job
CONTROL_PLANE_WEBHOOK_SECRET=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/oauth/github/callback

# Hash ids
HASHIDS_SALT=mlops_paas_secret_salt

# Cloudflare token
TUNNEL_TOKEN=

# Harbor Robot Account
HARBOR_USERNAME=robot_user-images+model-packager
HARBOR_PASSWORD=
HARBOR_GITHUB_USERNAME=robot_mlops-paas+github-actions
HARBOR_GITHUB_PASSWORD=
HARBOR_USER_PROJECT=user-images
HARBOR_REGISTRY_URL=registry.mlops-nids-nt114.id.vn

# Cosign (Image Signing)
COSIGN_PASSWORD=
COSIGN_PRIVATE_KEY=

# SageMaker Training
AWS_SAGEMAKER_ROLE_ARN=
SAGEMAKER_INSTANCE_TYPE=ml.m5.large
SAGEMAKER_MAX_RUN=3600
SAGEMAKER_MAX_WAIT=7200
SAGEMAKER_OUTPUT_PREFIX=tenants
SAGEMAKER_SKLEARN_FRAMEWORK_VERSION=1.2-1
SAGEMAKER_PY_VERSION=py3
SAGEMAKER_USE_SPOT=True
LOCAL_TRAINING_TIMEOUT=1800
LOCAL_TRAINING_MAX_OUTPUT_MB=500
LOCAL_TRAINING_ALLOW_PIP_INSTALL=True

# User's model Endpoint
API_URL=
API_KEY=

# Python
PYTHONUTF8=1