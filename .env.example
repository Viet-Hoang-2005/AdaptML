# Local/Dev environment variables for the MLOps NIDS system
# Luu y:
# - File nay dung cho local scripts, local API, monitoring, va mot so utility scripts.
# - GitHub Actions phai duoc cau hinh bang GitHub Secrets.
# - Kaggle train.py doc AWS/MLflow auth secrets tu Kaggle Secrets, khong doc truc tiep tu file .env nay.

# Kaggle
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# AWS
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET_NAME=mlops-nids-artifacts
S3_TRAINING_DATA_PREFIX=training-data/

# GitHub
GITHUB_TOKEN=your_github_token
GITHUB_REPO=your_github_org_or_user/your_repo_name

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_MODEL_NAME=NIDS-XGBoost

# Database
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_HOST_RW=localhost
DB_HOST_RO=localhost
DB_PORT=5432
DB_NAME=mlops_nids_db

# Monitoring
DRIFT_THRESHOLD=0.6
EVIDENTLY_TRIGGER_THRESHOLD=100

# Messaging
REDPANDA_BROKERS=localhost:19092

# Python
PYTHONUTF8=1
